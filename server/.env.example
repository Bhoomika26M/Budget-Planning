# ==========================================
# BudgetBuddy Server Environment Variables
# ==========================================

# Database Connection URL:
# For SQLite (default for instant zero-config testing):
DATABASE_URL=sqlite:///./budgetbuddy.db

# For PostgreSQL (production & advanced setup):
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/budgetbuddy

# JWT Authentication Secrets
# (Generate a secure 32+ character string for production)
SECRET_KEY=change_this_to_a_super_secret_key_for_production_budgetbuddy_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Application Environment (development | testing | production)
ENVIRONMENT=development

# Allowed Frontend Origins for CORS (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

