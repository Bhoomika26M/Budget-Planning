# Copy to .env (or set these in your hosting dashboard). All are optional for local dev.

# SQLite is used when this is empty. Production example:
# DATABASE_URL=postgresql+psycopg2://budgetbuddy:password@localhost:5432/budgetbuddy
DATABASE_URL=

# Change this in production!
JWT_SECRET_KEY=dev-only-change-this-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Where the React app and this API are reachable (used for OAuth redirects + CORS)
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://127.0.0.1:8000
# Extra allowed origins, comma separated
CORS_ORIGINS=

# Load the 3 demo accounts + sample data on startup
SEED_DEMO_DATA=true

# Optional OAuth2 login (create OAuth apps; callback = BACKEND_URL/api/auth/oauth/<provider>/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional e-mail (password-reset OTP). Without it the OTP is shown on screen ("Demo OTP").
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
