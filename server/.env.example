DATABASE_URL=sqlite:///./budgetbuddy.db
# Generate locally with: py -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_MINUTES=30
# Optional first administrator account; set both values to enable bootstrap.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
# Comma-separated browser app origins for deployment. Defaults are local dev ports.
CORS_ALLOWED_ORIGINS=

# For PostgreSQL, set DATABASE_URL to your PostgreSQL connection string.
